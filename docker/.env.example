# This file contains environment variables
# that are required for the application to run backend services
# in a development environment.

# Keep this port synchronized with EXPO_PUBLIC_API_URL in apps/mobile/.env.
BACKEND_PORT=8000

# Database configurations
# Put the real connection string in docker/.env (gitignored), never here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# API keys
ANTHROPIC_API_KEY=
# Optional: override the Claude model used by the AI routes.
ANTHROPIC_MODEL=

# Clerk authentication
# Frontend API URL of the Clerk instance (the issuer of session tokens).
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Secret key (Clerk Dashboard > API keys); used to check the admin role.
CLERK_SECRET_KEY=
# Optional: comma-separated web origins allowed in the token's azp claim.
CLERK_AUTHORIZED_PARTIES=
